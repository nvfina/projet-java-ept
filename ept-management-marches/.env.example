# --- MySQL ---
MYSQL_ROOT_PASSWORD=ept_root_2024
MYSQL_HOST=localhost
MYSQL_PORT=3306

# --- Bases de données ---
DB_AUTH_NAME=ept_auth
DB_PROCUREMENT_NAME=ept_procurement
